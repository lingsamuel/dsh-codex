{
  "name": "@lingsamuel/dsh-codex",
  "version": "0.1.2",
  "icon": "./assets/plugin-icon.svg",
  "description": "在 DeepSeek Harness 中展示和操作本机 Codex 会话",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lingsamuel/dsh-codex.git"
  },
  "type": "module",
  "files": [
    "assets/plugin-icon.svg",
    "locale/",
    "dist/client.js",
    "dist/file-reference-search.mjs",
    "dist/session-markdown.mjs",
    "dist/session-media-references.mjs",
    "manual/",
    "profile/cordis.patch.yml",
    "profile/web-mode.yml",
    "src/host/",
    "src/shared/"
  ],
  "exports": {
    ".": "./src/host/plugin.mjs",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./profile/cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": ">=0.2.3-alpha.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "package:plugin": "node scripts/package.mjs",
    "prestart": "npm run build",
    "start": "node scripts/start.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "ws": "^8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-file-upload": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-file-reference-local": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-log-export": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-crypto": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.3-alpha.2",
    "diff": "^9.0.0",
    "esbuild": "^0.27.0",
    "eventsource-parser": "3.1.1",
    "micromark": "^4.0.3"
  }
}
